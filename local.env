# Local development environment for CogniOps
#
# Copy this file to .env and fill in your values:
#   cp local.env .env
#
# Required:
#   GEMINI_API_KEY — Google AI Studio / Vertex AI API key
#
# Optional (defaults are provided):
#   COGNIOPS_MODEL — model name (default: gemini-2.0-flash)
#   COGNIOPS_MODE  — shadow | advisory | enforce (default: shadow)
#   LOG_LEVEL      — DEBUG | INFO | WARNING | ERROR (default: INFO)
#   OPA_URL        — OPA server URL (default: http://opa:8181)

GEMINI_API_KEY=your-gemini-api-key-here

COGNIOPS_MODEL=gemini-2.0-flash
COGNIOPS_MODE=shadow
LOG_LEVEL=INFO

# Local OPA server (started by docker-compose)
OPA_URL=http://opa:8181

# BigQuery / GCP — left empty for local mode; writes fail gracefully
GCP_PROJECT_ID=
GCP_REGION=europe-west1
BIGQUERY_DATASET=agent_metrics
BIGQUERY_TABLE=runtime_decisions

# GCS buckets — left empty for local mode
CONFIG_BUCKET=
PROPOSALS_BUCKET=

# GitHub — left empty; issue creation skipped locally
GITHUB_REPO=
GITHUB_TOKEN=

# AgentOps — disabled locally
AGENTOPS_ENABLED=false
AGENTOPS_API_KEY=
